FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    ffmpeg \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
    torch==2.1.0 \
    transformers==4.33.2 \
    TTS==0.22.0 \
    flask \
    numpy \
    requests \
    runpod

# Must be set before model download to accept Coqui license non-interactively
ENV COQUI_TOS_AGREED=1

# Pre-bake XTTS v2 model weights (~2GB) from HuggingFace directly.
# Bypasses Coqui's CDN (unreliable since they shut down in 2024) and avoids
# loading the model into RAM during build (which OOMs on CI runners).
# TTS checks ~/.local/share/tts/tts_models--multilingual--multi-dataset--xtts_v2/
# at startup and skips download if files are present.
RUN python3 -c "\
import os; \
from huggingface_hub import snapshot_download; \
dest = os.path.expanduser('~/.local/share/tts/tts_models--multilingual--multi-dataset--xtts_v2'); \
os.makedirs(dest, exist_ok=True); \
snapshot_download('coqui/XTTS-v2', local_dir=dest, ignore_patterns=['*.git*', '*.gitattributes']); \
print('XTTS v2 downloaded to:', dest) \
"

WORKDIR /app
COPY handler.py .

EXPOSE 8000
CMD ["python3", "-u", "handler.py"]
